# prove-api runtime configuration (see settings.py)
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit it.

# "server" enables usage logging (@log_request); anything else is a no-op.
PROVEAPI_SOURCE=local

# geolocation-db.com lookup key used by utils_api.get_ip_location.
# Unrelated to prove_shared's PROVE_API_KEY (the AsyncAuth signing key).
PROVEAPI_GEO_API_KEY=

PROVEAPI_LOG_PATH=./logs/api/
PROVEAPI_LOG_FILENAME=api.log
PROVEAPI_MAX_CONNECTIONS=1
